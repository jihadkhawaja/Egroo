<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SignalR DTOs and the media runtime use reflection-based JSON serialization. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Avalonia needs the native SkiaSharp and HarfBuzz assets linked into the runtime. -->
    <WasmBuildNative>true</WasmBuildNative>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="../App/Egroo.Avalonia.csproj" />
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    <Content Include="../../Egroo.UI/wwwroot/favicon.ico" Link="wwwroot/favicon.ico" />
    <Content Include="../../Egroo.UI/wwwroot/js/clientRuntime.js;../../Egroo.UI/wwwroot/js/egrooCrypto.js;../../Egroo.UI/wwwroot/js/webrtcInterop*.js;../../Egroo.Client/Realtime/nearbyRtc.js"
             Link="wwwroot/runtime/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
