<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaWebViewVersion)" />
    <AvaloniaResource Include="../../Egroo.UI/wwwroot/favicon.ico" Link="Assets/egroo.ico" />
    <ProjectReference Include="../../Egroo.UI/Egroo.UI.csproj" />
  </ItemGroup>
  <Target Name="GenerateEgrooApiUrlResource" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_EgrooApiUrlResource>$(IntermediateOutputPath)EgrooApiUrl.txt</_EgrooApiUrlResource>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_EgrooApiUrlResource)"
                      Lines="$([MSBuild]::Escape('$(EgrooApiUrl)'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(_EgrooApiUrlResource)" LogicalName="Egroo.Avalonia.EgrooApiUrl.txt" />
      <FileWrites Include="$(_EgrooApiUrlResource)" />
    </ItemGroup>
  </Target>
</Project>
