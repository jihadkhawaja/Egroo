<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaWebViewVersion)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EgrooApiUrl</_Parameter1>
      <_Parameter2>$(EgrooApiUrl)</_Parameter2>
    </AssemblyAttribute>
    <AvaloniaResource Include="../../Egroo.UI/wwwroot/favicon.ico" Link="Assets/egroo.ico" />
    <EmbeddedResource Include="../../Egroo.Client/Realtime/nearbyRtc.js;../../Egroo.UI/wwwroot/js/clientRuntime.js"
                      LogicalName="Egroo.Avalonia.Nearby.%(Filename)%(Extension)" />
    <ProjectReference Include="../../Egroo.UI/Egroo.UI.csproj" />
  </ItemGroup>
</Project>
