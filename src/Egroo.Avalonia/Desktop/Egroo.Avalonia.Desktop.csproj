<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Egroo</AssemblyName>
    <ApplicationIcon>../../Egroo.UI/wwwroot/favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="../App/Egroo.Avalonia.csproj" />
  </ItemGroup>
  <Target Name="BundleMacApp" AfterTargets="Publish" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <PropertyGroup>
      <MacAppBundle>$(PublishDir)../Egroo.app</MacAppBundle>
      <MacAppContents>$(MacAppBundle)/Contents</MacAppContents>
    </PropertyGroup>
    <ItemGroup>
      <MacAppFile Include="$(PublishDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="Info.plist" DestinationFolder="$(MacAppContents)" />
    <Copy SourceFiles="@(MacAppFile)" DestinationFiles="@(MacAppFile->'$(MacAppContents)/MacOS/%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- The copied .NET apphost needs a seal for the completed bundle. Sign nested code first. -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <MacAppNativeLibrary Include="$(MacAppContents)/MacOS/**/*.dylib" />
    </ItemGroup>
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX')) And '@(MacAppNativeLibrary)' != ''"
          Command="/usr/bin/codesign --force --sign - &quot;%(MacAppNativeLibrary.FullPath)&quot;" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Command="/usr/bin/codesign --force --sign - &quot;$(MacAppBundle)&quot;" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Command="/usr/bin/codesign --verify --deep --strict &quot;$(MacAppBundle)&quot;" />
  </Target>
</Project>
