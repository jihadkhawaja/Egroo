<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <AvaloniaWebViewVersion>12.1.2</AvaloniaWebViewVersion>
    <EgrooApiUrl Condition="'$(EgrooApiUrl)' == ''">https://api.egroo.org/</EgrooApiUrl>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
